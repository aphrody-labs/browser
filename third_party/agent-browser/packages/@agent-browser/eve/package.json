{
  "name": "@agent-browser/eve",
  "version": "0.43.0",
  "description": "eve extension that gives agents a full browser automation tool set backed by agent-browser",
  "type": "module",
  "sideEffects": false,
  "eve": {
    "extension": {
      "source": "./extension",
      "dist": "./dist/extension"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.mjs"
    },
    "./tools": {
      "types": "./dist/tools/index.d.ts",
      "default": "./dist/tools/index.mjs"
    },
    "./sandbox": {
      "types": "./dist/sandbox/sandbox.d.ts",
      "default": "./dist/sandbox/sandbox.js"
    }
  },
  "scripts": {
    "build": "bun run --bun eve extension build && bun build extension/lib/sandbox.ts --root extension/lib --outdir dist/sandbox --no-bundle --target node --dts",
    "prepare": "bun run --cwd ../sandbox build && bun run build",
    "test": "bun run --cwd ../sandbox build && bun run build && bun test"
  },
  "keywords": [
    "agent-browser",
    "eve",
    "eve-extension",
    "browser-automation",
    "sandbox"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/vercel-labs/agent-browser",
    "directory": "packages/@agent-browser/eve"
  },
  "bugs": {
    "url": "https://github.com/vercel-labs/agent-browser/issues"
  },
  "homepage": "https://agent-browser.dev",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@agent-browser/sandbox": "workspace:^",
    "zod": "4.4.3"
  },
  "peerDependencies": {
    "eve": ">=0.84.0"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "ai": "7.0.102",
    "eve": "0.84.0"
  }
}
