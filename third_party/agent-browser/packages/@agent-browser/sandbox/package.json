{
  "name": "@agent-browser/sandbox",
  "version": "0.43.0",
  "description": "Helpers for running agent-browser inside sandbox runtimes",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "mcp-tools.json",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./vercel": {
      "types": "./dist/vercel.d.ts",
      "import": "./dist/vercel.js"
    },
    "./mcp-tools.json": "./mcp-tools.json"
  },
  "scripts": {
    "build": "bun build src/index.ts src/mcp.ts src/shared.ts src/vercel.ts src/version.ts --root src --outdir dist --no-bundle --target node --dts",
    "prepack": "bun run build",
    "test": "bun test"
  },
  "keywords": [
    "agent-browser",
    "sandbox",
    "vercel",
    "eve",
    "browser-automation"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/vercel-labs/agent-browser",
    "directory": "packages/@agent-browser/sandbox"
  },
  "bugs": {
    "url": "https://github.com/vercel-labs/agent-browser/issues"
  },
  "homepage": "https://agent-browser.dev",
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@vercel/sandbox": ">=1.0.0"
  },
  "peerDependenciesMeta": {
    "@vercel/sandbox": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/bun": "^1.4.4"
  }
}
